---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudyHero from "../../components/CaseStudyHero.astro";
import { url } from "../../site.ts";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

// The 60-second scan layer: a jump list built from the body's own section
// headings, so it never drifts out of sync with the content.
const sections = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={data.title} description={data.description}>
  <CaseStudyHero
    title={data.title}
    subtitle={data.subtitle}
    tags={data.tags}
    snapshot={data.snapshot}
    image={data.heroImage}
  />

  <div class="wrap measure-hero">
    <div class="cs-body">
      {
        sections.length > 2 && (
          <nav class="cs-index" aria-label="Case study sections">
            <p class="cs-index-label reveal">In this case study</p>
            <ol>
              {sections.map((section, i) => (
                <li class="reveal">
                  <a href={`#${section.slug}`}>
                    <span class="cs-index-n">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span class="cs-index-text">{section.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <article class="prose">
        <Content />
      </article>

      {
        data.next && (
          <nav class="cs-next" aria-label="Next case study">
            <p class="t-meta">Next case study</p>
            <a href={url(data.next.href)} class="cs-next-link">
              <span class="t-h2 cs-next-title">{data.next.title} →</span>
            </a>
            <p class="cs-next-blurb">{data.next.blurb}</p>
          </nav>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .cs-body {
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
  }

  /* The jump list spans the same edges as the hero image above it: four
     cells across, two rows, thin separators between cells in the same
     language as the snapshot and the homepage figures. */
  .cs-index-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .cs-index ol {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 900px) {
    .cs-index ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .cs-index li {
    border-bottom: 1px solid var(--color-border);
  }

  .cs-index li:nth-child(2n) {
    border-left: 1px solid var(--color-border);
  }

  @media (min-width: 900px) {
    .cs-index li:nth-child(2n) {
      border-left: 0;
    }

    .cs-index li:not(:nth-child(4n + 1)) {
      border-left: 1px solid var(--color-border);
    }
  }

  .cs-index a {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    height: 100%;
    padding: 1.125rem 1.25rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .cs-index li:nth-child(odd) a {
    padding-left: 0;
  }

  @media (min-width: 900px) {
    .cs-index li:nth-child(odd) a {
      padding-left: 1.25rem;
    }

    .cs-index li:nth-child(4n + 1) a {
      padding-left: 0;
    }
  }

  .cs-index-n {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .cs-index-text {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  @media (hover: hover) and (pointer: fine) {
    .cs-index a:hover .cs-index-text {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  /* The body starts a full section below the index, not against its rule. */
  .cs-index + .prose {
    margin-top: var(--section-y);
  }

  .cs-next {
    max-width: var(--measure);
    margin-top: var(--section-y);
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .cs-next {
      margin-top: var(--section-y);
    }
  }

  .cs-next-link {
    display: inline-block;
    margin-top: 1rem;
    text-decoration: none;
  }

  .cs-next-title {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
    transition: text-decoration-color 150ms ease;
  }

  .cs-next-link:hover .cs-next-title,
  .cs-next-link:focus-visible .cs-next-title {
    text-decoration-color: var(--color-text);
  }

  .cs-next-blurb {
    margin-top: 1rem;
    max-width: 46ch;
    color: var(--color-text-muted);
  }
</style>

<style is:global>
  /* Section headings get a little more air in the decision-led structure,
     and a scroll offset so the sticky header never covers a jump target. */
  .prose h2 {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
</style>
