---
import BaseLayout from "../layouts/BaseLayout.astro";
import { EMAIL, LINKEDIN_URL } from "../site.ts";
---

<BaseLayout
  title="Contact"
  description="Exploring Lead and Principal Product Designer roles in fintech, banking and complex product environments."
>
  <div class="wrap measure-hero">
    <div class="contact">
      <h1 class="t-h1">Let's talk</h1>

      <div class="contact-copy">
        <p>
          I'm currently exploring Lead and Principal Product Designer roles,
          particularly in fintech, banking and complex product environments.
        </p>
        <p>
          The strongest fit is regulated fintech, enterprise SaaS, healthcare, or
          any complex-system domain where the interface is only part of the
          problem.
        </p>
      </div>

      <ul class="contact-links">
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        <li>
          <a href={LINKEDIN_URL} rel="noopener noreferrer" target="_blank"
            >LinkedIn →</a
          >
        </li>
      </ul>

      <p class="contact-note t-meta">
        Based in India. Open to opportunities globally.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .contact {
    max-width: var(--measure);
    padding-block: 4rem 2rem;
    min-height: 55vh;
  }

  @media (min-width: 768px) {
    .contact {
      padding-block: 7rem 2rem;
    }
  }

  .contact-copy {
    margin-top: 2.5rem;
  }

  .contact-copy p + p {
    margin-top: 1.5rem;
  }

  .contact-links {
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
    font-size: 1.125rem;
  }

  .contact-links a {
    text-underline-offset: 0.2em;
  }

  .contact-note {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.7rem;
  }
</style>
