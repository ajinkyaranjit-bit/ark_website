---
import BaseLayout from "../layouts/BaseLayout.astro";
import { EMAIL, LINKEDIN_URL, RESUME_PATH, url } from "../site.ts";
---

<BaseLayout
  title="Contact"
  description="Exploring Lead and Principal Product Designer roles in fintech, banking and complex product environments."
>
  <div class="wrap measure-hero">
    <div class="contact">
      <h1 class="t-h1 reveal">Get in touch</h1>

      <div class="contact-copy reveal">
        <p>
          I'm currently exploring Lead and Principal Product Designer roles,
          particularly in fintech, banking and complex product environments.
        </p>
        <p>
          The strongest fit is regulated fintech, enterprise SaaS, healthcare, or
          any complex-system domain where the interface is only part of the
          problem.
        </p>
      </div>

      <div class="contact-actions reveal">
        <a class="btn btn--solid" href={`mailto:${EMAIL}`}>Get in touch</a>
        <a
          class="btn btn--ghost"
          href={LINKEDIN_URL}
          rel="noopener noreferrer"
          target="_blank">LinkedIn</a
        >
        <a class="btn btn--ghost" href={url(RESUME_PATH)} target="_blank" rel="noopener">
          Resume
        </a>
      </div>

      <p class="contact-note t-meta reveal">
        Based in Pune, India. Open to opportunities globally.
      </p>

    </div>
  </div>
</BaseLayout>

<style>
  .contact {
    max-width: var(--measure);
    padding-block: var(--page-top) 2rem;
    min-height: 55vh;
  }

  @media (min-width: 768px) {
    .contact {
      padding-block: var(--page-top) 2rem;
    }
  }

  .contact-copy {
    margin-top: 2.5rem;
  }

  .contact-copy p + p {
    margin-top: 1.5rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 2.5rem;
  }

  .contact-note {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
</style>
