---
import BaseLayout from "../layouts/BaseLayout.astro";
import Band from "../components/Band.astro";
import { EMAIL, LINKEDIN_URL, RESUME_PATH, url } from "../site.ts";

const principles = [
  {
    title: "Understand the system first",
    body: "Before I start moving screens around, I want to know what is actually happening underneath — the people, states, rules, dependencies and exceptions.",
  },
  {
    title: "Make the complicated easier to act on",
    body: "I'm less interested in making complexity disappear than in making sure the person using the product knows what is happening, what matters, and what they need to do next.",
  },
  {
    title: "Stay close to the work",
    body: "Leading design doesn't mean stepping away from it. I still map flows, review interactions, prototype ideas and sit with users. I also spend a lot of time helping designers and stakeholders get to the same decision.",
  },
];

const numbers = [
  { value: "9+", label: "years designing products" },
  { value: "5,000+", label: "branch staff using a platform I currently design for" },
  { value: "16", label: "products designed during my time at Nearby" },
  { value: "7", label: "designers in the largest team I've built and led" },
];

const experience = [
  {
    company: "Ungrammary",
    role: "Senior UX Lead",
    dates: "2024 — now",
    detail:
      "Banking, healthcare and consumer products — including Kotak Cloud Branch, FYN and TrueMeds.",
  },
  {
    company: "okoders",
    role: "Lead Designer",
    dates: "2021 — 2024",
    detail:
      "Promoted from Senior UX/UI Designer; built and led a seven-designer team across multiple client products.",
  },
  {
    company: "Nearby Technologies",
    role: "Product Designer",
    dates: "2017 — 2021",
    detail:
      "Joined as the first designer and worked across PayNearby, BuyNearby and LoanNearby as the company scaled.",
  },
];
---

<BaseLayout
  title="About"
  description="Lead Product Designer with 9+ years across fintech, banking and consumer products. Currently at Ungrammary, leading UX across large banking programs while staying hands-on with the design."
  personSchema
>
  <div class="wrap measure-hero">
    <div class="about">
      <!-- Hero -->
      <section class="about-hero">
        <h1 class="t-h1">
          I design products for the messy parts of the real world.
        </h1>
        <div class="about-hero-copy">
          <p class="t-lead">
            Banking workflows. Approval chains. Healthcare decisions. Products
            where the simplest screen usually sits on top of a much more
            complicated system.
          </p>
          <p>
            I'm Ajinkya, a Lead Product Designer with 9+ years across fintech,
            banking and consumer products. I currently work at Ungrammary,
            leading UX across large banking programs while staying hands-on
            with the design.
          </p>
        </div>
      </section>

      <!-- A little about me -->
      <section class="block block--split">
        <h2 class="t-h2">A little about me</h2>
        <div class="block-copy">
          <p>
            I started my career at Nearby Technologies as the company's first
            designer. The team grew, the products grew, and so did my role —
            from designing interfaces to figuring out how payments, lending and
            merchant products should actually work.
          </p>
          <p>
            Since then, I've worked across consumer products, SaaS, healthcare
            and enterprise banking. I've built a design team of seven, led
            smaller product teams, and worked with PMs, engineers, operations
            and business teams on products that rarely come with clean
            requirements.
          </p>
          <p>
            Today, most of my work sits in fintech and banking. I like problems
            with multiple users, awkward constraints and enough complexity that
            drawing the screen is rarely the hardest part.
          </p>
          <p class="block-close">I still design. That matters to me.</p>
        </div>
      </section>

      <!-- How I work -->
      <section class="block">
        <h2 class="t-h2">How I work</h2>
        <div class="board board--3">
          {
            principles.map((p, i) => (
              <div class="cell">
                <p class="t-meta">{String(i + 1).padStart(2, "0")}</p>
                <h3 class="t-h3 cell-title">{p.title}</h3>
                <p class="cell-body">{p.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- A few numbers -->
      <section class="block">
        <h2 class="t-h2">A few numbers</h2>
        <dl class="board board--4 numbers">
          {
            numbers.map((n) => (
              <div class="cell">
                <dd class="number-value">{n.value}</dd>
                <dt class="number-label">{n.label}</dt>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- Where I've worked -->
      <section class="block">
        <h2 class="t-h2">Where I've worked</h2>
        <ul class="board board--3 entries">
          {
            experience.map((e) => (
              <li class="cell">
                <p class="t-meta">{e.dates}</p>
                <h3 class="entry-company">{e.company}</h3>
                <p class="entry-role">{e.role}</p>
                <p class="cell-body">{e.detail}</p>
              </li>
            ))
          }
        </ul>
        <p class="education">
          MCA · Design Thinking &amp; Innovation, IIT Delhi · HCI, Interaction
          Design Foundation
        </p>
      </section>

      <!-- Final CTA -->
      <section class="block">
        <Band
          label="What's next"
          heading="I'm looking for the next difficult product problem."
          body="I'm currently exploring Lead and Principal Product Designer roles, particularly in fintech, banking and complex product environments."
        >
          <a class="solid" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <a
            class="outline"
            href={LINKEDIN_URL}
            rel="noopener noreferrer"
            target="_blank">LinkedIn</a
          >
          <a class="outline" href={url(RESUME_PATH)} target="_blank" rel="noopener"
            >Resume</a
          >
        </Band>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    padding-block: 3rem 2rem;
  }

  @media (min-width: 768px) {
    .about {
      padding-block: 5rem 2rem;
    }
  }

  /* Hero — quiet: one headline, two short paragraphs, nothing else. */
  .about-hero h1 {
    max-width: var(--measure-wide);
  }

  .about-hero-copy {
    margin-top: 2.25rem;
    max-width: var(--measure);
  }

  .about-hero-copy .t-lead {
    color: var(--color-text-muted);
  }

  .about-hero-copy p + p {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.62;
  }

  /* Sections */
  .block {
    margin-top: 5rem;
  }

  @media (min-width: 768px) {
    .block {
      margin-top: 7rem;
    }
  }

  /* Heading left, copy right — the same editorial split as the case
     studies, so the About page and the work share one rhythm. */
  .block-copy {
    margin-top: 1.5rem;
  }

  .block-copy p {
    font-size: 1.125rem;
    line-height: 1.62;
  }

  .block-copy p + p {
    margin-top: 1.25rem;
  }

  .block-close {
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .block--split {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: 4rem;
      align-items: start;
    }

    .block-copy {
      margin-top: 0;
    }
  }

  /* Boards: equal columns with a rule on top of each cell. */
  .board {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2.5rem 2rem;
  }

  @media (min-width: 640px) {
    .board--3,
    .board--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .board--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .board--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .cell {
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-text);
  }

  .cell-title {
    margin-top: 0.875rem;
  }

  .cell-body {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* A few numbers */
  .number-value {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4.5vw, 3.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .number-label {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  /* Where I've worked */
  .entry-company {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .entry-role {
    margin-top: 0.375rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .education {
    margin-top: 2.5rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
