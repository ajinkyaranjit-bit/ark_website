---
import BaseLayout from "../layouts/BaseLayout.astro";
import Band from "../components/Band.astro";
import { Image } from "astro:assets";
import photoKotak from "../assets/about/01-kotak-team.webp";
import photoWorkshop from "../assets/about/02-workshop.webp";
import photoTeam from "../assets/about/03-team-goa.webp";

const photos = [
  { src: photoKotak, alt: "Ajinkya with two colleagues in front of the Kotak sign at the bank's office." },
  { src: photoWorkshop, alt: "The product, design and technology team after a whiteboard workshop in a Kotak meeting room." },
  { src: photoTeam, alt: "The Ungrammary team together on a lawn under palm trees in Goa." },
];
import { EMAIL, LINKEDIN_URL, RESUME_PATH, url } from "../site.ts";

const principles = [
  {
    title: "Understand the system first",
    body: "Before I start moving screens around, I want to know what is actually happening underneath — the people, states, rules, dependencies and exceptions.",
  },
  {
    title: "Make the complicated easier to act on",
    body: "I'm less interested in making complexity disappear than in making sure the person using the product knows what is happening, what matters, and what they need to do next.",
  },
  {
    title: "Stay close to the work",
    body: "Leading design doesn't mean stepping away from it. I still map flows, review interactions, prototype ideas and sit with users. I also spend a lot of time helping designers and stakeholders get to the same decision.",
  },
];

// Same four as the homepage strip, so the two pages never contradict.
const numbers = [
  { value: "5,000+", label: "branch staff using a platform I currently design for" },
  { value: "6", label: "core services designed end to end on Cloud Branch" },
  { value: "60M+", label: "transactions a year on that platform" },
  { value: "7", label: "designers in the largest team I've built and led" },
];

const experience = [
  {
    company: "Ungrammary",
    role: "Senior UX Lead",
    dates: "2024 to now",
    detail:
      "Banking, healthcare and consumer products, including Kotak Cloud Branch, FYN and TrueMeds.",
  },
  {
    company: "okoders",
    role: "Lead Designer",
    dates: "2021 to 2024",
    detail:
      "One of the first designers to join. Promoted from Senior UX/UI Designer, then built and led a seven-designer team across multiple client products.",
  },
  {
    company: "Nearby Technologies",
    role: "Product Designer",
    dates: "2017 to 2021",
    detail:
      "Founding designer. Worked across PayNearby, BuyNearby and LoanNearby as the company scaled, designing 16 products in four years.",
  },
];
---

<BaseLayout
  title="About"
  description="Lead Product Designer with 9+ years across fintech, banking and consumer products. Currently at Ungrammary, leading UX across large banking programs while staying hands-on with the design."
  personSchema
>
  <div class="wrap measure-hero">
    <div class="about">
      <!-- Hero -->
      <section class="about-hero reveal">
        <h1 class="t-h1">
          I design products for the messy parts of the real world.
        </h1>
        <div class="about-hero-copy">
          <p class="t-lead">
            Banking workflows. Approval chains. Healthcare decisions. Products
            where the simplest screen usually sits on top of a much more
            complicated system.
          </p>
          <p>
            I'm Ajinkya, a Lead Product Designer with 9+ years across fintech,
            banking and consumer products. I currently work at Ungrammary,
            leading UX across large banking programs while staying hands-on
            with the design.
          </p>
        </div>
      </section>

      <!-- Photos -->
      <section class="block photos reveal" aria-label="Photos">
        {
          photos.map((p) => (
            <Image
              src={p.src}
              alt={p.alt}
              width={800}
              height={600}
              class="photo"
              loading="lazy"
            />
          ))
        }
      </section>

      <!-- A little about me -->
      <section class="block block--split reveal">
        <h2 class="t-h2 reveal">A little about me</h2>
        <div class="block-copy">
          <p>
            I started my career as the first designer at Nearby Technologies,
            working across payments, lending and merchant products as the
            company scaled. Later, I joined okoders as one of its first
            designers. Those experiences shaped how I work today: understand
            the system first, stay close to the people using it, and make
            complicated workflows easier to act on.
          </p>
          <p>
            Since then, I've worked across fintech, healthcare, SaaS and
            consumer products, built and led design teams of up to seven, and
            stayed hands-on with product strategy, flows, prototyping and
            validation. Today, most of my work sits in banking and fintech, but
            the problems I enjoy are broader: multiple users, messy constraints
            and products where understanding the system matters as much as
            designing the interface.
          </p>
          <p class="block-close">
            I lead design, but I still stay close to the work.
          </p>
        </div>
      </section>

      <!-- How I work -->
      <section class="block">
        <h2 class="t-h2 reveal">How I work</h2>
        <div class="board board--3">
          {
            principles.map((p, i) => (
              <div class="cell reveal">
                <p class="t-meta">{String(i + 1).padStart(2, "0")}</p>
                <h3 class="t-h3 cell-title">{p.title}</h3>
                <p class="cell-body">{p.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- A few numbers -->
      <section class="block">
        <h2 class="t-h2 reveal">A few numbers</h2>
        <dl class="board board--4 numbers nums-tabular">
          {
            numbers.map((n) => (
              <div class="cell reveal">
                <dd class="number-value">{n.value}</dd>
                <dt class="number-label">{n.label}</dt>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- Where I've worked -->
      <section class="block">
        <h2 class="t-h2 reveal">Where I've worked</h2>
        <ul class="board board--3 entries">
          {
            experience.map((e) => (
              <li class="cell reveal">
                <p class="t-meta">{e.dates}</p>
                <h3 class="entry-company">{e.company}</h3>
                <p class="entry-role">{e.role}</p>
                <p class="cell-body">{e.detail}</p>
              </li>
            ))
          }
        </ul>
        <p class="education reveal">
          MCA · Design Thinking &amp; Innovation, IIT Delhi · HCI, Interaction
          Design Foundation
        </p>
      </section>

      <!-- Final CTA -->
      <section class="block">
        <Band
          label="What's next"
          heading="I'm looking for the next difficult product problem."
          body="I'm currently exploring Lead and Principal Product Designer roles, particularly in fintech, banking and complex product environments."
        >
          <a class="solid" href={`mailto:${EMAIL}`}>Get in touch</a>
          <a
            class="outline"
            href={LINKEDIN_URL}
            rel="noopener noreferrer"
            target="_blank">LinkedIn</a
          >
          <a class="outline" href={url(RESUME_PATH)} target="_blank" rel="noopener"
            >Resume</a
          >
        </Band>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    padding-block: var(--page-top) 2rem;
  }

  @media (min-width: 768px) {
    .about {
      padding-block: var(--page-top) 2rem;
    }
  }

  /* Hero — quiet: one headline, two short paragraphs, nothing else. */
  .about-hero h1 {
    max-width: var(--measure-wide);
  }

  .about-hero-copy {
    margin-top: 2.25rem;
    max-width: var(--measure);
  }

  .about-hero-copy .t-lead {
    color: var(--color-text-muted);
  }

  .about-hero-copy p + p {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.62;
  }

  /* Photos — a quiet row, same edges as everything else. */
  .photos {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .photos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  /* Sections */
  .block {
    margin-top: var(--section-y);
  }

  @media (min-width: 768px) {
    .block {
      margin-top: var(--section-y);
    }
  }


  /* Heading left, copy right — the same editorial split as the case
     studies, so the About page and the work share one rhythm. */
  .block-copy {
    margin-top: 1.5rem;
  }

  /* Measured, not guessed: Geist's `ch` (the width of a zero, ~11.9px here)
     is much wider than its average letter (~7.5px), so a ch-based measure
     reads far longer than it looks. 44ch lands the line near 70 characters,
     inside the comfortable range, and the column keeps its 33/67 split. */
  .block-copy p {
    max-width: 44ch;
    font-size: 1.125rem;
    line-height: 1.62;
  }

  /* Excludes the closing note. With Astro's scoping attributes this compound
     outscores `.block-copy .block-close`, so without the :not() it was
     clamping the closing note back to normal paragraph spacing. */
  .block-copy p + p:not(.block-close) {
    margin-top: 1.25rem;
  }

  /* A quieter line set apart by whitespace, not weight. Muted tone measures
     4.71:1 on the page background, so it stays AA while reading softer.
     Scoped under .block-copy so it outranks the `p + p` rule above, which
     was otherwise capping the gap at the normal paragraph spacing. */
  .block-copy .block-close {
    margin-top: 2.25rem;
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 900px) {
    .block--split {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: 4rem;
      align-items: start;
    }

    .block-copy {
      margin-top: 0;
    }
  }

  /* Boards: equal columns with a rule on top of each cell. */
  .board {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2.5rem 2rem;
  }

  @media (min-width: 640px) {
    .board--3,
    .board--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .board--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .board--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .cell {
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-strong);
  }

  .cell-title {
    margin-top: 0.875rem;
  }

  .cell-body {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* A few numbers */
  .number-value {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 3.6vw, 3rem);
    font-weight: var(--display-weight);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .number-label {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  /* Where I've worked */
  .entry-company {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    letter-spacing: var(--display-tracking);
    font-size: 1.625rem;
    font-weight: var(--display-weight);
    line-height: 1.15;
  }

  .entry-role {
    margin-top: 0.375rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .education {
    margin-top: 2.5rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
