---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, url } from "../site.ts";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  /** Emit Person schema.org JSON-LD (homepage + about only). */
  personSchema?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  personSchema = false,
} = Astro.props;

const pageTitle = title ? `${title} — Ajinkya Kale` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url("/og.png"), Astro.site);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ajinkya Kale",
  jobTitle: "Lead Product Designer",
  description: SITE_DESCRIPTION,
  email: "mailto:ajinkyaranjit@gmail.com",
  url: Astro.site?.toString(),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Pune",
    addressCountry: "IN",
  },
  worksFor: { "@type": "Organization", name: "Ungrammary" },
  knowsAbout: [
    "Product Design",
    "Enterprise UX",
    "Design Systems",
    "Fintech",
    "Corporate Banking",
    "Healthcare",
  ],
  sameAs: ["https://linkedin.com/in/ajinkya-kale-88487b82"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&display=swap"
    />

    {
      personSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(person)}
        />
      )
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
