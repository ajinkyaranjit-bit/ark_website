---
import { Image } from "astro:assets";
import { url, EMAIL, RESUME_PATH } from "../site.ts";
import avatar from "../assets/about/avatar.webp";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const links = [
  { href: url("/#work"), label: "Work", match: "/work" },
  { href: url("/about"), label: "About", match: "/about" },
];
---

<header class="site-header">
  <div class="wrap measure-hero header-inner">
    <a href={url("/")} class="wordmark">
      <Image
        src={avatar}
        alt=""
        width={80}
        height={80}
        class="wordmark-avatar"
        loading="eager"
      />
      <span>Ajinkya Kale</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.match) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={url(RESUME_PATH)} target="_blank" rel="noopener">Resume</a>
        </li>
        <li>
          <a class="email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.875rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.3125rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark-avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-muted);
    padding: 0.4rem 0.8rem;
    border-radius: var(--pill);
    transition:
      background 140ms ease,
      color 140ms ease;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-text);
    background: var(--color-warm);
  }

  /* The address itself, not a button — nothing to "get in touch" through yet. */
  nav a.email {
    color: var(--color-text);
    margin-left: 0.4rem;
  }

  @media (max-width: 640px) {
    nav a.email {
      display: none;
    }

    .header-inner {
      gap: 1rem;
    }

    nav a {
      padding: 0.4rem 0.6rem;
    }
  }

  /* On the narrowest screens the picture stands in for the name. */
  @media (max-width: 480px) {
    .wordmark span {
      display: none;
    }
  }
</style>
