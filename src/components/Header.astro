---
import { url } from "../site.ts";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const links = [
  { href: url("/#work"), label: "Work", match: "/work" },
  { href: url("/about"), label: "About", match: "/about" },
];
---

<header class="site-header">
  <div class="wrap measure-hero header-inner">
    <a href={url("/")} class="wordmark">Ajinkya Kale</a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.match) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="cta"
            href={url("/contact")}
            aria-current={isActive("/contact") ? "page" : undefined}
          >
            Get in touch
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.875rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-muted);
    padding: 0.4rem 0.8rem;
    border-radius: var(--pill);
    transition:
      background 140ms ease,
      color 140ms ease;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-text);
    background: var(--color-warm);
  }

  /* The one filled control on the page. */
  nav a.cta {
    background: var(--color-text);
    color: #fff;
    margin-left: 0.4rem;
    padding-inline: 1.05rem;
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  nav a.cta:hover,
  nav a.cta[aria-current="page"] {
    background: var(--color-text);
    color: #fff;
    opacity: 0.88;
    transform: translateY(-1px);
  }
</style>
