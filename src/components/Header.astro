---
import { url } from "../site.ts";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const links = [
  { href: url("/#work"), label: "Work", match: "/work" },
  { href: url("/about"), label: "About", match: "/about" },
  { href: url("/contact"), label: "Contact", match: "/contact" },
];
---

<header class="site-header">
  <div class="wrap measure-hero header-inner">
    <a href={url("/")} class="wordmark">Ajinkya Kale</a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.match) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid transparent;
  }

  .header-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
  }

  .wordmark {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    text-decoration: none;
  }

  .wordmark:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  nav ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-muted);
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-text);
  }

  nav a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }
</style>
