---
import { Image } from "astro:assets";

/**
 * An image slot, or a labelled stub when the artwork does not exist yet.
 *
 * Two things here exist because of one problem: the case-study artwork is
 * wide, poster-shaped and dense with UI, and a 375px phone renders it at
 * roughly 320 CSS px once container padding is taken out. At that size the
 * panels inside are texture, not information.
 *
 *   1. `--media-bleed` — the container tells this component how much side
 *      padding to escape on narrow screens, and the figure pulls itself
 *      edge to edge. Worth ~15% more width, which is not nothing.
 *   2. `zoomable` — a :target lightbox. Tapping the image opens it over the
 *      page at a width where the UI is legible, pannable, and closable back
 *      to the spot you were reading. No JavaScript, matching the rest of the
 *      site, and better than a link that dumps a bare .webp into a new tab.
 *
 * The real fix for mobile is art-directed crops exported per breakpoint, not
 * a shrunken poster. Until those exist this makes the posters inspectable.
 */
export interface Props {
  aspect?: "16:9" | "4:3" | "1:1" | "3:2" | "4:5";
  label: string;
  description: string;
  caption?: string;
  class?: string;
  /** When present the slot renders this image instead of the placeholder. */
  src?: ImageMetadata;
  alt?: string;
  /**
   * Tap-to-enlarge. On by default wherever there is real artwork, because
   * every case-study image is denser than a phone can show. Turned off in
   * WorkCard, where the image is part of a link to the case study and
   * intercepting that tap would be a worse trade.
   */
  zoomable?: boolean;
}

const {
  aspect = "16:9",
  label,
  description,
  caption,
  class: className = "",
  src,
  alt,
  zoomable = true,
} = Astro.props;

const ratios: Record<string, string> = {
  "16:9": "16 / 9",
  "4:3": "4 / 3",
  "1:1": "1 / 1",
  "3:2": "3 / 2",
  "4:5": "4 / 5",
};

const zoom = Boolean(src) && zoomable;

/* Ids only have to be unique within a page, and every figure on a page has
   its own label. The suffix keeps the close link distinct from the panel. */
const slug = label
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "");
const panelId = `fig-${slug}`;
const anchorId = `${panelId}-at`;

/* 750 and 1080 are the two that matter — a 2x and 3x phone asking for 100vw.
   Without them the browser jumped to 1280 and paid for pixels it could not
   show, or settled for 640 and rendered the panels soft. */
const widths = src
  ? [640, 750, 1080, 1280, src.width].filter(
      (w, i, a) => w <= src.width && a.indexOf(w) === i,
    )
  : [];
---

<figure class={`ph-figure ${className}`} id={zoom ? anchorId : undefined}>
  {
    src ? (
      zoom ? (
        <a class="ph-zoom" href={`#${panelId}`} aria-label={`Enlarge: ${label}`}>
          <Image
            src={src}
            alt={alt ?? description}
            widths={widths}
            sizes="(min-width: 1180px) 1100px, 100vw"
            loading="lazy"
            decoding="async"
            class="ph-img"
          />
          <span class="ph-zoom-hint" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 1.8H1.8V6M10 1.8h4.2V6M10 14.2h4.2V10M6 14.2H1.8V10" />
            </svg>
            <span class="ph-zoom-word">Enlarge</span>
          </span>
        </a>
      ) : (
        <Image
          src={src}
          alt={alt ?? description}
          widths={widths}
          sizes="(min-width: 1180px) 1100px, 100vw"
          loading="lazy"
          decoding="async"
          class="ph-img"
        />
      )
    ) : (
      <div
        class="ph"
        style={`--ph-ratio: ${ratios[aspect]}`}
        role="img"
        aria-label={`Placeholder — ${label}. ${description}`}
      >
        <span class="ph-label" aria-hidden="true">
          {label}
        </span>
        <span class="ph-desc" aria-hidden="true">
          {description}
        </span>
      </div>
    )
  }
  {caption && <figcaption class="ph-caption">{caption}</figcaption>}
</figure>

{
  zoom && src && (
    <div class="ph-lightbox" id={panelId} role="dialog" aria-label={label}>
      <a class="ph-lightbox-scrim" href={`#${anchorId}`} aria-label="Close" />
      <div class="ph-lightbox-bar">
        <span class="ph-lightbox-label">{label}</span>
        <a class="ph-lightbox-close" href={`#${anchorId}`}>
          Close
        </a>
      </div>
      <div class="ph-lightbox-scroll">
        <Image
          src={src}
          alt={alt ?? description}
          widths={[1280, src.width].filter(
            (w, i, a) => w <= src.width && a.indexOf(w) === i,
          )}
          sizes="min(1400px, 220vw)"
          loading="lazy"
          decoding="async"
          class="ph-lightbox-img"
        />
      </div>
    </div>
  )
}

<style>
  .ph-figure {
    margin: 0;
  }

  /* Escape the container's side padding on narrow screens. The container
     declares how much via --media-bleed; without one this is a no-op, so a
     Placeholder dropped anywhere new behaves exactly as it did before. */
  @media (max-width: 767px) {
    .ph-figure {
      margin-inline: calc(var(--media-bleed, 0px) * -1);
    }

    /* Edge to edge, so the rounded frame and hairline would only draw
       attention to the crop. */
    .ph-figure :global(.ph-img) {
      border-radius: 0;
      border-inline: 0;
    }

    .ph-caption {
      padding-inline: var(--media-bleed, 0px);
    }
  }

  .ph {
    position: relative;
    aspect-ratio: var(--ph-ratio);
    border-radius: var(--radius-sm);
    background: var(--color-warm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem 1.5rem;
    text-align: center;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .ph {
      padding: 2.5rem 3rem;
    }
  }

  .ph-label {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .ph-desc {
    max-width: 44ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted-on-warm);
    text-wrap: pretty;
  }

  /* Real artwork takes the same rounded frame as the warm well, plus a
     hairline — these thumbnails have near-white grounds that would otherwise
     dissolve into a white card.

     No aspect-ratio and no object-fit here on purpose. The slot's `aspect`
     sizes the *placeholder*; forcing real artwork into it cropped any asset
     whose true ratio differed (the 4:3 case-study exports in a 16:9 slot lost
     their top and bottom). Width 100% + height auto lets the file's own ratio
     decide, so no export can be clipped. */
  .ph-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-warm);
  }

  /* ── Zoom trigger ─────────────────────────────────────────────── */
  .ph-zoom {
    display: block;
    position: relative;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .ph-zoom-hint {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-meta);
    font-size: 0.75rem;
    font-weight: 500;
    color: #fff;
    background: color-mix(in srgb, #0a0a0a 72%, transparent);
    backdrop-filter: blur(8px);
    border-radius: var(--pill);
    padding: 0.34rem 0.66rem;
    opacity: 0;
    transform: translateY(2px);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .ph-zoom:hover .ph-zoom-hint,
  .ph-zoom:focus-visible .ph-zoom-hint {
    opacity: 1;
    transform: translateY(0);
  }

  /* On touch there is no hover to reveal it, and it is the only signal that a
     dense image can be opened — so it stays visible. The word goes, though:
     these posters carry their own caption along the bottom edge, and a full
     text pill sat on top of it. A glyph says the same thing in a quarter of
     the space. */
  @media (pointer: coarse) {
    .ph-zoom-hint {
      opacity: 1;
      transform: none;
      right: 0.6rem;
      bottom: 0.6rem;
      gap: 0;
      padding: 0.42rem;
    }

    /* Simply gone. The badge is aria-hidden and the link carries its own
       "Enlarge: …" label, so nothing is lost by dropping the word here. */
    .ph-zoom-word {
      display: none;
    }
  }

  /* ── Lightbox ─────────────────────────────────────────────────── */
  .ph-lightbox {
    display: none;
  }

  .ph-lightbox:target {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 90;
    /* Nearly solid, and blurred behind. At 92% the sticky header ghosted
       through legibly enough to read as a leak rather than as depth. */
    background: color-mix(in srgb, #0a0a0a 96%, transparent);
    backdrop-filter: blur(10px) saturate(120%);
  }

  .ph-lightbox-scrim {
    position: absolute;
    inset: 0;
    text-decoration: none;
  }

  .ph-lightbox-bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.25rem;
  }

  @media (min-width: 768px) {
    .ph-lightbox-bar {
      padding: 1.25rem 1.75rem;
    }
  }

  .ph-lightbox-label {
    font-family: var(--font-meta);
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.62);
  }

  .ph-lightbox-close {
    flex: none;
    font-family: var(--font-meta);
    font-size: 0.8125rem;
    font-weight: 500;
    color: #fff;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--pill);
    padding: 0.55rem 1rem;
    transition:
      background 150ms ease,
      border-color 150ms ease;
  }

  .ph-lightbox-close:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
  }

  /* The point of the panel: the image sits wider than the viewport so the UI
     inside it is legible, and the reader pans. */
  .ph-lightbox-scroll {
    position: absolute;
    inset: 3.75rem 0 0;
    z-index: 1;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    /* Grid rather than block so a panorama shorter than the panel sits in the
       middle of it instead of hard against the top bar. It still overflows
       horizontally, which is the whole point. */
    display: grid;
    align-content: center;
    justify-items: start;
    padding-bottom: 2rem;
  }

  .ph-lightbox-img {
    width: 220vw;
    max-width: none;
    height: auto;
    border-radius: 0;
  }

  @media (min-width: 768px) {
    .ph-lightbox-scroll {
      justify-items: center;
      padding: 0 1.75rem 2rem;
    }

    .ph-lightbox-img {
      width: min(1400px, 96vw);
      border-radius: var(--radius-sm);
    }
  }

  .ph-caption {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    font-style: italic;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
</style>
