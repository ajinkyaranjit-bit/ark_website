---
import { Image } from "astro:assets";

export interface Props {
  aspect?: "16:9" | "4:3" | "1:1" | "3:2";
  label: string;
  description: string;
  caption?: string;
  class?: string;
  /** When present the slot renders this image instead of the placeholder. */
  src?: ImageMetadata;
  alt?: string;
}

const {
  aspect = "16:9",
  label,
  description,
  caption,
  class: className = "",
  src,
  alt,
} = Astro.props;

const ratios: Record<string, string> = {
  "16:9": "16 / 9",
  "4:3": "4 / 3",
  "1:1": "1 / 1",
  "3:2": "3 / 2",
};
---

<figure class={`ph-figure ${className}`}>
  {
    src ? (
      <Image
        src={src}
        alt={alt ?? description}
        widths={[640, 960, 1280, src.width]}
        sizes="(min-width: 1180px) 1100px, 100vw"
        loading="lazy"
        decoding="async"
        class="ph-img"
        style={`--ph-ratio: ${ratios[aspect]}`}
      />
    ) : (
      <div class="ph" style={`--ph-ratio: ${ratios[aspect]}`} role="img" aria-label={`Placeholder — ${label}. ${description}`}>
        <span class="ph-label" aria-hidden="true">{label}</span>
        <span class="ph-desc" aria-hidden="true">{description}</span>
      </div>
    )
  }
  {caption && <figcaption class="ph-caption">{caption}</figcaption>}
</figure>

<style>
  .ph-figure {
    margin: 0;
  }

  .ph {
    position: relative;
    aspect-ratio: var(--ph-ratio);
    border-radius: var(--radius-sm);
    background: var(--color-warm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem 1.5rem;
    text-align: center;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .ph {
      padding: 2.5rem 3rem;
    }
  }

  .ph-label {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-label);
  }

  .ph-desc {
    max-width: 44ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted-on-warm);
    text-wrap: pretty;
  }

  /* Real artwork takes the same rounded frame as the warm well, plus a
     hairline — these thumbnails have near-white grounds that would otherwise
     dissolve into a white card. */
  .ph-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ph-ratio);
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-warm);
  }

  .ph-caption {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    font-style: italic;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
</style>
