---
import { Image } from "astro:assets";

export interface Props {
  aspect?: "16:9" | "4:3" | "1:1" | "3:2";
  label: string;
  description: string;
  caption?: string;
  class?: string;
  /** When present the slot renders this image instead of the placeholder. */
  src?: ImageMetadata;
  alt?: string;
}

const {
  aspect = "16:9",
  label,
  description,
  caption,
  class: className = "",
  src,
  alt,
} = Astro.props;

const ratios: Record<string, string> = {
  "16:9": "16 / 9",
  "4:3": "4 / 3",
  "1:1": "1 / 1",
  "3:2": "3 / 2",
};
---

<figure class={`ph-figure ${className}`}>
  {
    src ? (
      <Image
        src={src}
        alt={alt ?? description}
        widths={[600, 900, 1350, 1672]}
        sizes="(min-width: 980px) 900px, 100vw"
        loading="lazy"
        decoding="async"
        class="ph-img"
        style={`--ph-ratio: ${ratios[aspect]}`}
      />
    ) : (
      <div class="ph" style={`--ph-ratio: ${ratios[aspect]}`} role="img" aria-label={`Placeholder — ${label}. ${description}`}>
        <span class="ph-label" aria-hidden="true">{label}</span>
        <span class="ph-desc" aria-hidden="true">{description}</span>
        <span class="ph-corner ph-corner--tr" aria-hidden="true"></span>
        <span class="ph-corner ph-corner--bl" aria-hidden="true"></span>
      </div>
    )
  }
  {caption && <figcaption class="ph-caption">{caption}</figcaption>}
</figure>

<style>
  .ph-figure {
    margin: 0;
  }

  .ph {
    position: relative;
    aspect-ratio: var(--ph-ratio);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem 1.5rem;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .ph {
      padding: 3.5rem 3rem 2.5rem;
    }
  }

  .ph-label {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-family: var(--font-meta);
    font-weight: 500;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .ph-label {
      top: 1.25rem;
      left: 1.25rem;
      font-size: 0.75rem;
    }
  }

  .ph-desc {
    max-width: 46ch;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* Two hairline corner ticks — reads as a considered frame, not a
     broken image. */
  .ph-corner {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: var(--color-tag-border);
    opacity: 0.5;
  }

  .ph-corner--tr {
    top: 1rem;
    right: 1rem;
    border-top: 1px solid;
    border-right: 1px solid;
  }

  .ph-corner--bl {
    bottom: 1rem;
    left: 1rem;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }

  .ph-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ph-ratio);
    object-fit: cover;
    /* Same hairline as .ph so a page mixing images and placeholders frames
       them identically. */
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .ph-caption {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    font-style: italic;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
</style>
