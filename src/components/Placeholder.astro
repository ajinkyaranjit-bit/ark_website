---
export interface Props {
  aspect?: "16:9" | "4:3" | "1:1" | "3:2";
  label: string;
  description: string;
  caption?: string;
  class?: string;
}

const {
  aspect = "16:9",
  label,
  description,
  caption,
  class: className = "",
} = Astro.props;

const ratios: Record<string, string> = {
  "16:9": "16 / 9",
  "4:3": "4 / 3",
  "1:1": "1 / 1",
  "3:2": "3 / 2",
};
---

<figure class={`ph-figure ${className}`}>
  <div class="ph" style={`--ph-ratio: ${ratios[aspect]}`} role="img" aria-label={`Placeholder — ${label}. ${description}`}>
    <span class="ph-label" aria-hidden="true">{label}</span>
    <span class="ph-desc" aria-hidden="true">{description}</span>
  </div>
  {caption && <figcaption class="ph-caption">{caption}</figcaption>}
</figure>

<style>
  .ph-figure {
    margin: 0;
  }

  .ph {
    position: relative;
    aspect-ratio: var(--ph-ratio);
    border-radius: var(--radius-sm);
    background: var(--color-warm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem 1.5rem;
    text-align: center;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .ph {
      padding: 2.5rem 3rem;
    }
  }

  .ph-label {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-label);
  }

  .ph-desc {
    max-width: 44ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted-on-warm);
    text-wrap: pretty;
  }

  .ph-caption {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    font-style: italic;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
</style>
