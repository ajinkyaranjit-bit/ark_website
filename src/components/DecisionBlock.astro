---
import Draft from "./Draft.astro";

/**
 * The core unit of a Lead-level case study.
 *
 * `why` and `result` are the two fields that separate a decision from a
 * process step. When either is missing the section still renders, but the
 * missing field shows as an authoring slot in dev and is dropped from the
 * production build — so an unfinished decision never publishes as if it
 * were complete.
 */
export interface Props {
  n: string;
  decision: string;
  problem: string;
  evidence: string;
  why?: string;
  consequence: string;
  result?: string;
  /** Names the evidence still needed, shown only in dev. */
  needs?: string;
}

const { n, decision, problem, evidence, why, consequence, result, needs } =
  Astro.props;

const fields = [
  { label: "Problem", value: problem },
  { label: "Evidence", value: evidence },
  { label: "Why this over the alternatives", value: why },
  { label: "Design consequence", value: consequence },
].filter((f) => f.value);
---

<section class="decision reveal">
  <header class="decision-head">
    <span class="decision-n" aria-hidden="true">{n}</span>
    <div>
      <p class="decision-kicker">Decision {n}</p>
      <h3 class="decision-title">{decision}</h3>
    </div>
  </header>

  <dl class="decision-grid">
    {
      fields.map((f) => (
        <div class="decision-field">
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))
    }
  </dl>

  {
    result && (
      <div class="decision-result">
        <p class="decision-result-label">Result</p>
        <p class="decision-result-text">{result}</p>
      </div>
    )
  }

  {needs && <Draft label={`Decision ${n}: still needed`}>{needs}</Draft>}
</section>

<style>
  /* Each decision is one card: number and title, the four reasoning fields
     as a 2 x 2 grid, and the result as a dark strip that closes the card.
     The reasoning is read, the result is remembered, so the result gets the
     weight. */
  .decision {
    margin-top: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-rest);
    overflow: hidden;
  }

  :global(.prose) > h2 + .decision {
    margin-top: 2rem;
  }

  .decision-head {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.75rem 1.5rem 0;
  }

  @media (min-width: 768px) {
    .decision-head {
      gap: 2rem;
      padding: 2.25rem 2.25rem 0;
    }
  }

  .decision-n {
    flex-shrink: 0;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .decision-kicker {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .decision-title {
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    line-height: 1.15;
  }

  .decision-grid {
    margin: 1.75rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .decision-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .decision-field:nth-child(even) {
      border-left: 1px solid var(--color-border);
    }

    .decision-field:nth-child(n + 3) {
      border-top: 1px solid var(--color-border);
    }
  }

  .decision-field {
    padding: 1.375rem 1.5rem;
  }

  @media (max-width: 767px) {
    .decision-field + .decision-field {
      border-top: 1px solid var(--color-border);
    }
  }

  @media (min-width: 768px) {
    .decision-field {
      padding: 1.5rem 2.25rem;
    }
  }

  .decision-field dt {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .decision-field dd {
    margin: 0.5rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  .decision-result {
    display: grid;
    gap: 0.5rem;
    padding: 1.375rem 1.5rem;
    background: var(--color-text);
    color: #fff;
  }

  @media (min-width: 768px) {
    .decision-result {
      grid-template-columns: 9rem 1fr;
      align-items: baseline;
      padding: 1.5rem 2.25rem;
    }
  }

  .decision-result-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
  }

  .decision-result-text {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }
</style>
