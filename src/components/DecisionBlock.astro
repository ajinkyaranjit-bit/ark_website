---
import Draft from "./Draft.astro";

/**
 * The core unit of a Lead-level case study.
 *
 * `why` and `result` are the two fields that separate a decision from a
 * process step. When either is missing the section still renders, but the
 * missing field shows as an authoring slot in dev and is dropped from the
 * production build — so an unfinished decision never publishes as if it
 * were complete.
 */
export interface Props {
  n: string;
  decision: string;
  problem: string;
  evidence: string;
  why?: string;
  consequence: string;
  result?: string;
  /** Names the evidence still needed, shown only in dev. */
  needs?: string;
}

const { n, decision, problem, evidence, why, consequence, result, needs } =
  Astro.props;

const rows = [
  { label: "Problem", value: problem },
  { label: "Evidence", value: evidence },
  { label: "Why this over the alternatives", value: why },
  { label: "Design consequence", value: consequence },
  { label: "Result", value: result },
].filter((r) => r.value);
---

<section class="decision">
  <header class="decision-head">
    <p class="t-meta">Decision {n}</p>
    <h3 class="decision-title">{decision}</h3>
  </header>

  <dl class="decision-rows">
    {
      rows.map((row) => (
        <div class="decision-row">
          <dt class="t-meta">{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))
    }
  </dl>

  {needs && <Draft label={`Decision ${n} — still needed`}>{needs}</Draft>}
</section>

<style>
  .decision {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .decision-title {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.4375rem, 2.4vw, 1.875rem);
    letter-spacing: 0;
    line-height: 1.2;
    max-width: 30ch;
  }

  .decision-rows {
    margin: 2rem 0 0;
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 700px) {
    .decision-rows {
      grid-template-columns: 11rem 1fr;
      gap: 1.5rem 2rem;
    }

    .decision-row {
      display: contents;
    }
  }

  .decision-row dt {
    font-size: 0.6875rem;
  }

  @media (min-width: 700px) {
    .decision-row dt {
      padding-top: 0.2rem;
    }
  }

  .decision-row dd {
    margin: 0.375rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (min-width: 700px) {
    .decision-row dd {
      margin: 0;
    }
  }
</style>
