---
import Placeholder from "./Placeholder.astro";
import Tag from "./Tag.astro";

/**
 * A featured project on the homepage. Five things, in this order:
 * category → project → story hook → what I worked on → audience/scale.
 *
 * The hook is what differentiates the three cards from each other, so it
 * carries the display face and sits directly under the project name. Role,
 * duration and company deliberately do not appear here — that is case study
 * material, and putting it on the homepage makes the page read as a resume.
 */
export interface Props {
  number: string;
  category: string;
  title: string;
  hook: string;
  description: string;
  audience: string;
  href: string;
  tags: string[];
  image: {
    label: string;
    description: string;
    aspect?: "16:9" | "4:3" | "1:1" | "3:2";
  };
}

const {
  number,
  category,
  title,
  hook,
  description,
  audience,
  href,
  tags,
  image,
} = Astro.props;
---

<article class="card">
  <a href={href} class="card-link">
    <span class="card-eyebrow t-meta">
      {number} <span class="card-slash" aria-hidden="true">/</span>
      {category}
    </span>

    <h3 class="card-title">{title}</h3>
    <p class="card-hook">{hook}</p>
    <p class="card-desc">{description}</p>
  </a>

  <ul class="card-tags">
    <li><Tag label={audience} solid /></li>
    {
      tags.map((tag) => (
        <li>
          <Tag label={tag} />
        </li>
      ))
    }
  </ul>

  <p class="card-cta">
    <span class="card-cta-text">View case study →</span>
  </p>

  <div class="card-media">
    <Placeholder
      aspect={image.aspect ?? "16:9"}
      label={image.label}
      description={image.description}
    />
  </div>
</article>

<style>
  .card {
    display: block;
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  @media (min-width: 768px) {
    .card {
      padding: 2.75rem;
    }
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.055);
  }

  .card + .card {
    margin-top: 1.5rem;
  }

  /* Text keeps a readable measure even though the card is wide. */
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    max-width: 60ch;
  }

  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .card-eyebrow {
    display: block;
    font-size: 0.6875rem;
  }

  .card-slash {
    opacity: 0.45;
    margin-inline: 0.15rem;
  }

  .card-title {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.1;
  }

  /* The hook steps out of the display face on purpose: a serif line under a
     serif title made two voices compete. Sans at medium weight in near-black
     reads as the highlight it is. */
  .card-hook {
    margin-top: 0.875rem;
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 1.8vw, 1.3125rem);
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -0.005em;
    color: var(--color-text);
    max-width: 34ch;
  }

  .card-desc {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.62;
    color: var(--color-text-muted);
    max-width: 52ch;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    position: relative;
    z-index: 1;
  }

  .card-cta {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .card-cta-text::after {
    content: "";
    display: inline-block;
    transition: transform 160ms ease;
  }

  .card:hover .card-cta-text {
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
  }

  /* Full card width — these hold dense system diagrams, not thumbnails. */
  .card-media {
    margin-top: 2.25rem;
  }

  @media (min-width: 768px) {
    .card-media {
      margin-top: 2.75rem;
    }
  }
</style>
