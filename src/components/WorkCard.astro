---
import Placeholder from "./Placeholder.astro";
import Tag from "./Tag.astro";

/**
 * A featured project on the homepage.
 *
 * Two layouts, so the three projects do not repeat one pattern down the page:
 *
 *   feature — the lead project. Text and image side by side from 960px, the
 *             image carrying the larger share of the width.
 *   compact — the supporting projects. Image on top, text beneath, built to
 *             sit two across.
 *
 * Both collapse to image-then-text below 960px. The whole card is one link;
 * the tags sit above the link overlay so they stay selectable text.
 */
export interface Props {
  variant?: "feature" | "compact";
  category: string;
  title: string;
  hook: string;
  description: string;
  audience: string;
  href: string;
  tags: string[];
  image: {
    label: string;
    description: string;
    aspect?: "16:9" | "4:3" | "1:1" | "3:2" | "4:5";
    src?: ImageMetadata;
    alt?: string;
  };
}

const {
  variant = "compact",
  category,
  title,
  hook,
  description,
  audience,
  href,
  tags,
  image,
} = Astro.props;
---

<article class={`card card--${variant} reveal`}>
  <div class="card-media">
    <Placeholder
      aspect={image.aspect ?? "3:2"}
      label={image.label}
      description={image.description}
      src={image.src}
      alt={image.alt}
      zoomable={false}
    />
  </div>

  <div class="card-body">
    <a href={href} class="card-link">
      <span class="card-category">{category}</span>
      <h3 class="card-title">{title}</h3>
      <p class="card-hook">{hook}</p>
      {variant === "feature" && <p class="card-desc">{description}</p>}
    </a>

    <ul class="card-tags">
      <li><Tag label={audience} solid /></li>
      {
        tags.map((tag) => (
          <li>
            <Tag label={tag} />
          </li>
        ))
      }
    </ul>

    <p class="card-cta" aria-hidden="true">
      View case study
      <span class="card-cta-arrow">→</span>
    </p>
  </div>
</article>

<style>
  .card {
    --card-pad: clamp(1rem, 2.4vw, 1.5rem);
    position: relative;
    display: grid;
    gap: 1.75rem;
    padding: var(--card-pad);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-rest);
    transition:
      transform 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-3px);
      box-shadow:
        var(--shadow-lift),
        0 24px 60px -24px rgb(var(--aurora-periwinkle) / 0.3),
        0 18px 44px -28px rgb(var(--aurora-apricot) / 0.26);
    }
  }

  .card:active {
    transform: scale(0.995);
    transition-duration: 120ms;
  }

  /* Media sits inset, with a radius that nests inside the card's: outer
     radius minus the padding between them, so the two curves stay parallel. */
  .card-media :global(.ph-img),
  .card-media :global(.ph) {
    border-radius: calc(var(--radius) - var(--card-pad) * 0.5);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0 0.25rem 0.25rem;
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .card-category {
    display: block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .card-title {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    line-height: 1.1;
  }

  .card-hook {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    font-weight: 450;
    line-height: 1.45;
    color: var(--color-text);
    max-width: 40ch;
  }

  .card-desc {
    margin-top: 0.875rem;
    font-size: 0.9375rem;
    line-height: 1.62;
    color: var(--color-text-muted);
    max-width: 48ch;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 1.375rem 0 0;
    padding: 0;
    list-style: none;
    position: relative;
    z-index: 1;
  }

  /* Pushed to the bottom of the body so two compact cards side by side end
     on the same line even when one hook runs longer than the other. */
  .card-cta {
    margin-top: auto;
    padding-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .card-cta-arrow {
    transition: transform 220ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover .card-cta-arrow {
      transform: translateX(3px);
    }
  }

  /* Feature: text left, image right, from 960px. The image takes the larger
     share because it is the proof; the text is the caption to it. */
  @media (min-width: 960px) {
    .card--feature {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas: "body media";
      align-items: center;
      gap: 2.5rem;
      padding: 1.25rem;
    }

    .card--feature .card-media {
      grid-area: media;
    }

    .card--feature .card-body {
      grid-area: body;
      padding: 1.5rem 0 1.5rem 1.5rem;
    }

    .card--feature .card-title {
      font-size: clamp(1.875rem, 2.8vw, 2.375rem);
    }
  }
</style>
