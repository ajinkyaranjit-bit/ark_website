---
import Placeholder from "./Placeholder.astro";
import Tag from "./Tag.astro";

/**
 * A featured project on the homepage. Five things, in this order:
 * category → project → story hook → what I worked on → audience/scale.
 *
 * The hook is what differentiates the three cards from each other, so it
 * carries the display face and sits directly under the project name. Role,
 * duration and company deliberately do not appear here — that is case study
 * material, and putting it on the homepage makes the page read as a resume.
 */
export interface Props {
  number: string;
  category: string;
  title: string;
  hook: string;
  description: string;
  audience: string;
  href: string;
  tags: string[];
  image: {
    label: string;
    description: string;
    aspect?: "16:9" | "4:3" | "1:1" | "3:2";
    src?: ImageMetadata;
    alt?: string;
  };
}

const {
  number,
  category,
  title,
  hook,
  description,
  audience,
  href,
  tags,
  image,
} = Astro.props;
---

<article class="card">
  <a href={href} class="card-link">
    <span class="card-eyebrow t-meta">
      {number} <span class="card-slash" aria-hidden="true">/</span>
      {category}
    </span>

    <h3 class="card-title">{title}</h3>
    <p class="card-hook">{hook}</p>
    <p class="card-desc">{description}</p>
    <p class="card-audience">{audience}</p>
  </a>

  <ul class="card-tags">
    {
      tags.map((tag) => (
        <li>
          <Tag label={tag} />
        </li>
      ))
    }
  </ul>

  <p class="card-cta">
    <span class="card-cta-text">View case study →</span>
  </p>

  <div class="card-media">
    <Placeholder
      aspect={image.aspect ?? "16:9"}
      label={image.label}
      description={image.description}
      src={image.src}
      alt={image.alt}
    />
  </div>
</article>

<style>
  .card {
    display: block;
    position: relative;
  }

  .card + .card {
    margin-top: 5.5rem;
  }

  @media (min-width: 768px) {
    .card + .card {
      margin-top: 9rem;
    }
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    max-width: var(--measure);
  }

  /* Overlay spans the whole article so the tags, CTA and image below are all
     part of the same click target. */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card-eyebrow {
    display: block;
    font-size: 0.6875rem;
  }

  .card-slash {
    opacity: 0.45;
    margin-inline: 0.15rem;
  }

  .card-title {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.4vw, 2.625rem);
    font-weight: 400;
    letter-spacing: -0.018em;
    line-height: 1.08;
  }

  .card-hook {
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.1vw, 1.625rem);
    letter-spacing: -0.012em;
    line-height: 1.24;
    /* No tighter cap than the body measure — a hook set to 24ch breaks a
       one-sentence hook across three ragged lines. */
    max-width: 34ch;
    text-wrap: balance;
  }

  .card-desc {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 58ch;
  }

  .card-audience {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.003em;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    max-width: var(--measure-wide);
    position: relative;
    z-index: 1;
  }

  .card-cta {
    margin-top: 1.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .card-cta-text {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: color-mix(
      in srgb,
      var(--color-text) 30%,
      transparent
    );
    transition: text-decoration-color 150ms ease;
  }

  .card:hover .card-cta-text,
  .card-link:focus-visible ~ .card-cta .card-cta-text {
    text-decoration-color: var(--color-text);
  }

  .card:hover .card-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.1em;
  }

  .card-media {
    margin-top: 2.5rem;
    max-width: var(--measure-wide);
  }

  @media (min-width: 768px) {
    .card-media {
      margin-top: 3rem;
    }
  }
</style>
