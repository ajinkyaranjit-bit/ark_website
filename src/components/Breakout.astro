---
/**
 * Case-study imagery at the full content width — the same edges as the hero
 * image above it — while body copy stays on the 680px measure. The prose
 * rules in global.css put every other block on the measure; this one opts out.
 */
---

<div class="breakout">
  <slot />
</div>

<style>
  .breakout {
    width: 100%;
    margin-block: 3rem;
  }

  @media (min-width: 900px) {
    .breakout {
      margin-block: 4rem;
    }
  }
</style>
