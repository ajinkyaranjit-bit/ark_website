---
/**
 * Case-study imagery at the full content width — the same edges as the hero
 * image above it — while body copy stays on the 680px measure. The prose
 * rules in global.css put every other block on the measure; this one opts out.
 */
---

<div class="breakout reveal">
  <slot />
</div>

<style>
  .breakout {
    width: 100%;
    margin-block: 3rem;
  }

  /* Below 768px the artwork escapes .wrap's side padding and runs the full
     viewport width. On a 375px screen that is 48px back — the difference
     between a diagram you can squint at and one you cannot. */
  @media (max-width: 767px) {
    .breakout {
      --media-bleed: var(--gutter);
    }
  }

  @media (min-width: 900px) {
    .breakout {
      margin-block: 4rem;
    }
  }
</style>
