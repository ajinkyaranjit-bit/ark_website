---
/**
 * Lead-level evidence: who was on the team, what Ajinkya personally owned as
 * distinct from the team, who needed aligning, and one concrete moment where
 * he changed the direction of the work.
 */
export interface Props {
  team: string;
  collaboration: string;
  owned: string[];
  moment?: { title: string; body: string };
}

const { team, collaboration, owned, moment } = Astro.props;
---

<div class="lb">
  <dl class="lb-rows">
    <div class="lb-row">
      <dt class="t-meta">Design team</dt>
      <dd>{team}</dd>
    </div>
    <div class="lb-row">
      <dt class="t-meta">Alignment needed across</dt>
      <dd>{collaboration}</dd>
    </div>
    <div class="lb-row">
      <dt class="t-meta">What I personally owned</dt>
      <dd>
        <ul class="lb-owned">
          {owned.map((item) => <li>{item}</li>)}
        </ul>
      </dd>
    </div>
  </dl>

  {
    moment && (
      <div class="lb-moment">
        <p class="t-meta">Leadership moment</p>
        <p class="lb-moment-title">{moment.title}</p>
        <p class="lb-moment-body">{moment.body}</p>
      </div>
    )
  }
</div>

<style>
  .lb {
    margin-top: 2rem;
  }

  .lb-rows {
    margin: 0;
    display: grid;
    gap: 2rem;
  }

  /* Same board as the outcomes: one column per row, rule on top of each. */
  @media (min-width: 860px) {
    .lb-rows {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 3rem;
    }
  }

  .lb-row {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-text);
  }

  .lb-row dt {
    font-size: 0.6875rem;
  }

  .lb-row dd {
    margin: 0.875rem 0 0;
    font-size: 1rem;
    line-height: 1.62;
  }

  .lb-owned {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .lb-owned li {
    background: var(--color-warm);
    border-radius: var(--pill);
    padding: 0.32rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted-on-warm);
  }

  .lb-moment {
    margin-top: 2.5rem;
    padding: 1.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-warm);
  }

  .lb-moment-title {
    margin-top: 0.75rem;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.4;
  }

  .lb-moment-body {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.65;
  }
</style>
