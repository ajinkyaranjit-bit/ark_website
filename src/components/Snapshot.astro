---
/**
 * The 10-second scan layer. A reviewer should get project, role, scale and
 * outcome from this block alone, without reading a paragraph.
 */
export interface Props {
  challenge: string;
  items: { label: string; value: string }[];
}

const { challenge, items } = Astro.props;

// Balance the last row rather than letting auto-fit leave an orphan: up to
// four items sit on one line, more than that split into two even rows.
const n = items.length;
const cols = n <= 4 ? n : Math.ceil(n / 2);
---

<section class="snapshot" aria-label="Snapshot">
  <p class="snapshot-challenge reveal">{challenge}</p>
  <dl class="snapshot-grid" style={`--snapshot-cols: ${cols}`}>
    {
      items.map((item) => (
        <div class="snapshot-item reveal">
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  /* No box. The challenge sentence carries the block, and the facts beneath
     it use the homepage figures' language: one rule above and below, thin
     vertical separators between columns. The same device on both pages is
     what makes the case study feel like part of the site. */
  .snapshot-challenge {
    max-width: 44rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.375rem, 2.3vw, 1.875rem);
    letter-spacing: -0.024em;
    line-height: 1.25;
  }

  .snapshot-grid {
    margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--color-border);
  }

  @media (min-width: 900px) {
    .snapshot-grid {
      grid-template-columns: repeat(var(--snapshot-cols), minmax(0, 1fr));
    }
  }

  .snapshot-item {
    padding: 1.5rem 1.25rem 1.5rem 0;
  }

  @media (max-width: 899px) {
    .snapshot-item:nth-child(even) {
      padding-left: 1.25rem;
      border-left: 1px solid var(--color-border);
    }

    .snapshot-item:nth-child(n + 3) {
      border-top: 1px solid var(--color-border);
    }
  }

  @media (min-width: 900px) {
    .snapshot-item {
      padding: 1.75rem 1.5rem;
    }

    .snapshot-item:first-child {
      padding-left: 0;
    }

    .snapshot-item + .snapshot-item {
      border-left: 1px solid var(--color-border);
    }
  }

  .snapshot-item dt {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .snapshot-item dd {
    margin: 0.5rem 0 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }
</style>
