---
/**
 * The 10-second scan layer. A reviewer should get project, role, scale and
 * outcome from this block alone, without reading a paragraph.
 */
export interface Props {
  challenge: string;
  items: { label: string; value: string }[];
}

const { challenge, items } = Astro.props;

// Balance the last row rather than letting auto-fit leave an orphan: up to
// four items sit on one line, more than that split into two even rows.
const n = items.length;
const cols = n <= 4 ? n : Math.ceil(n / 2);
---

<section class="snapshot" aria-label="Snapshot">
  <p class="snapshot-challenge">{challenge}</p>
  <dl class="snapshot-grid" style={`--snapshot-cols: ${cols}`}>
    {
      items.map((item) => (
        <div class="snapshot-item">
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .snapshot {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
  }

  @media (min-width: 768px) {
    .snapshot {
      padding: 2.5rem 2.75rem;
    }
  }

  .snapshot-challenge {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.3vw, 1.875rem);
    letter-spacing: 0;
    line-height: 1.22;
    max-width: 34ch;
  }

  .snapshot-grid {
    margin: 2.25rem 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .snapshot-grid {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
      gap: 1.75rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .snapshot-grid {
      grid-template-columns: repeat(var(--snapshot-cols), 1fr);
    }
  }

  .snapshot-item dt {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-label);
  }

  .snapshot-item dd {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
</style>
