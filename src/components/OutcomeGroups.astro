---
import Draft from "./Draft.astro";

/**
 * Outcomes, grouped by kind of impact and labelled by provenance.
 *
 * The provenance label is the point. A target presented as a measured result
 * is the fastest way to lose a senior reviewer, so every claim has to declare
 * which of these it is:
 *
 *   shipped  — delivered and in use. A fact about what was built, not a metric
 *   measured — verified in production after launch
 *   observed — seen in testing, UAT, analytics or operations
 *   target   — what the project was expected to achieve
 *   scale    — the size of the environment, not a result of the work
 *
 * `shipped` exists because scope is not a measurement. "Six services designed
 * end to end" and "later services inherited the pattern" are verifiable facts
 * about delivery, and on an enterprise programme they are usually the strongest
 * evidence available — but labelling them `measured` invites a reviewer to ask
 * "measured how?", and the honest answer is that they weren't. Say what they
 * actually are and they read as stronger, not weaker.
 *
 * Groups take an optional `note`, which IS rendered. Use it where a whole group
 * shares a provenance caveat — it is better to state the caveat once, plainly,
 * than to let a reviewer discover it.
 *
 * Set `verify: true` on any claim whose source Ajinkya has not yet confirmed.
 * It renders normally but raises a dev-only notice listing what to check.
 *
 * `note` is the instruction to himself about what still needs checking. It is
 * deliberately NOT rendered into the page — a live portfolio should not show a
 * reviewer "confirm this before publishing". It appears only in the dev-only
 * checklist below.
 */
export type ClaimKind = "shipped" | "measured" | "observed" | "target" | "scale";

export interface Claim {
  text: string;
  kind: ClaimKind;
  verify?: boolean;
  /** Author-facing only. Never rendered into the published page. */
  note?: string;
}

export interface Props {
  groups: { title: string; note?: string; claims: Claim[] }[];
}

const { groups } = Astro.props;

const KIND_LABEL: Record<ClaimKind, string> = {
  shipped: "Shipped",
  measured: "Measured",
  observed: "Observed",
  target: "Target",
  scale: "Scale",
};

const unverified = groups
  .flatMap((g) => g.claims)
  .filter((c) => c.verify);
---

<div class="og">
  {
    groups.map((group) => (
      <section class="og-group reveal">
        <h3 class="og-group-title">{group.title}</h3>
        {group.note && <p class="og-group-note">{group.note}</p>}
        <ul class="og-claims">
          {group.claims.map((claim) => (
            <li class="og-claim">
              <span class={`og-kind og-kind--${claim.kind}`}>
                {KIND_LABEL[claim.kind]}
              </span>
              <span class="og-text">{claim.text}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

{
  unverified.length > 0 && (
    <Draft label="Claims to verify before launch">
      <p>
        These are labelled by their most defensible reading of the source copy.
        Confirm the source of each, then either promote it to
        <code> measured </code> or leave it as is:
      </p>
      <ul>
        {unverified.map((c) => (
          <li>
            <strong>{c.text}</strong>
            {c.note && <> — {c.note}</>}
          </li>
        ))}
      </ul>
    </Draft>
  )
}

<style>
  .og {
    margin-top: 2rem;
    display: grid;
    gap: 2.5rem;
  }

  /* One column per group across the full width; the rule on top of each
     column is the only chrome. */
  @media (min-width: 860px) {
    .og {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: 0 3rem;
    }
  }

  .og-group {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-strong);
  }

  .og-group-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--display-weight);
    line-height: 1.2;
    letter-spacing: var(--display-tracking);
  }

  /* The caveat a whole group shares. Stated once, in the reader's path —
     small, but not hidden. */
  .og-group-note {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .og-claims {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.25rem;
  }

  .og-claim {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  .og-kind {
    justify-self: start;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-warm);
    border-radius: var(--pill);
    padding: 0.22rem 0.6rem;
    white-space: nowrap;
  }

  /* Solid pill = a fact that can be checked — what was delivered, or what was
     verified in production. Everything qualified (observed, target, scale)
     stays on the warm pill, so the two tiers read at a glance. */
  .og-kind--measured,
  .og-kind--shipped {
    background: var(--color-text);
    color: #fff;
  }

  .og-text {
    font-size: 1rem;
    line-height: 1.6;
  }

  .og-claims :global(code) {
    font-family: var(--font-meta);
    font-weight: 500;
    font-size: 0.85em;
  }
</style>
